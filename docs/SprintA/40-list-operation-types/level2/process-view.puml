@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE : wants to list all operation types
    activate FE
    
        FE -> BE : GET /operationTypes
        activate BE
        
            BE --> FE : returns operation types
        deactivate BE
    
        alt Couldn't Find Operation Types
        FE --> USER : informs error with suggestion
        else Operation Types Listed Successfully
        FE --> USER : lists all operation types
        end
        
    deactivate FE
            
deactivate USER

@enduml