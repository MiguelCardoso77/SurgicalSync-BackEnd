@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE : wants to edit existing operation type
    activate FE
    
        FE -> BE : GET /operationTypes
        activate BE
        
            BE --> FE : returns operation types
        deactivate BE
    
        FE --> USER : lists existing operation types and \n asks user to select one
    deactivate FE

    USER -> FE : selects the operation type to edit
    activate FE
    
        FE -->USER : requests new operation details
    deactivate FE
    
    USER -> FE : provides new operation details
    activate FE
    
        alt User Wrongly Changed The ID
           
        FE -> BE : PUT /operationTypes/id (with given data)
        activate BE
        
            BE --> FE : error: operation type id can't be changed
        deactivate BE 
        FE --> USER : informs error with suggestion
        
        else Operation Type Updated Successfully
        
        FE -> BE : PUT /operationTypes/id (with given data)
        activate BE
        
            BE --> FE : success: returns success message
        deactivate BE
        FE --> USER : shows success message
        
        end
        
    deactivate FE
            
deactivate USER

@enduml