@startuml
autonumber

title BackEnd Process View

participant "FrontEnd" as FE
participant "Controllers" as CN
participant "Services" as SV
participant "DTOs" as DTO
participant "Mappers" as MP
participant "Domain" as DM
participant "Repositories" as REPO
database "SQL Database" as SQL

activate FE
    FE -> CN : GET /operationTypes
    activate CN
        
        CN -> SV : GetAllAsync()
        activate SV
        
            note left of SV
                Process documented on use case 40
            end note
            SV --> CN : returns List<OperationTypeDTO>
        deactivate SV
        
        CN --> FE : returns List<OperationTypeDTO>
    deactivate CN

    FE -> CN: PUT /operationTypes/id (with given data)
    activate CN
    
        CN -> SV : Create(OperationTypeDTO)
        activate SV
        
            SV -> DTO : Create(OperationTypeDTO)
            activate DTO
            
alt Operation Type Updated Successfully
            
                DTO --> SV : returns OperationTypeDTO
            deactivate DTO
            
            SV -> MP : ToDomain(OperationTypeDTO)
            activate MP
            
                MP -> DM : Create(OperationType)
                activate DM
                     
                    DM --> MP : returns OperationType
                deactivate DM
            
                MP --> SV : returns OperationType
            deactivate MP
                
            SV -> REPO : UpdateAsync(OperationType)
            activate REPO
            
                REPO -> SQL : PUT /operationTypes/id (OperationType)
                activate SQL
                
                    SQL --> REPO : success: updated operation type (returns ID)
                deactivate SQL
                
                REPO --> SV : success: updated operation type (returns ID)
            deactivate REPO
            
            SV --> CN : success: updated operation type (returns ID)
        FE <-- CN: success: updated operation type (returns ID) 

else User Wrongly Changed The ID

            SV --> CN : error: operation type id can't be changed
        deactivate SV
        FE <-- CN: error: operation type id can't be changed
    deactivate CN     
               
deactivate FE
end

@enduml