@startuml
autonumber

actor "Admin" as USER
participant "<<System>>\n SurgicalSync" as SYSTEM

activate USER

    USER -> SYSTEM: wants to edit existing operation type
    activate SYSTEM

        SYSTEM --> USER : lists existing operation types and \n asks user to select one
    deactivate SYSTEM
        
    USER -> SYSTEM : selects the operation type to edit
    activate SYSTEM
    
        SYSTEM --> USER : requests new operation details
    deactivate SYSTEM
    
    USER -> SYSTEM : provides new operation details
    activate SYSTEM
        alt User Wrongly Changed The ID
           USER <-- SYSTEM : informs error with suggestion
        else Operation Type Updated Successfully
           USER <-- SYSTEM : shows success message
        end
    deactivate SYSTEM
    
deactivate USER
@enduml