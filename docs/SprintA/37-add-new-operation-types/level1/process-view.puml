@startuml
autonumber

actor "Admin" as USER
participant "<<System>>\n SurgicalSync" as SYSTEM

activate USER

    USER -> SYSTEM: wants to add a new operation type
    activate SYSTEM

        SYSTEM --> USER : requests data (name, requiredStaff, duration)
    deactivate SYSTEM
        
    USER -> SYSTEM : provides data
    activate SYSTEM
        alt Operation Type Already Exists
           USER <-- SYSTEM : informs error with suggestion
        else Operation Type Added Successfully
           USER <-- SYSTEM : shows success message
        end
    deactivate SYSTEM
    
deactivate USER
@enduml