@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE : wants to add a staff profile to the hospital's roster
    activate FE
    
    FE -> BE : GET / staffProfileNotInHospitalRoster
    activate BE
    
    BE --> FE : return list of staff profile not in hospital's roster
    deactivate BE
    
    FE --> USER : shows list of staff profiles not in hospital's roster
    deactivate FE

    USER -> FE : selects a staff profile 
    activate FE
    
    FE -> BE : POST / addToHospitalRoster
    activate BE
    
    BE --> FE : return operation success
    deactivate BE
    
    FE --> USER: operation success
    deactivate FE
    
deactivate USER

@enduml