@startuml
autonumber

title BackEnd Process View

participant "FrontEnd" as FE
participant "Controllers" as CN
participant "Services" as SV
participant "DTOs" as DTO
participant "Mappers" as MP
participant "Domain" as DM
participant "Repositories" as REPO
database "SQL Database" as SQL

activate FE
    FE -> CN: GET /staff/id
    activate CN
    
        CN -> SV : Create(StaffProfileDTO)
        activate SV
        
            SV -> DTO : Create(StaffProfileDTO)
            activate DTO
            
            
                DTO --> SV : returns StaffProfileDTO
            deactivate DTO
            
            SV -> MP : MapToDomain(StaffProfileDTO)
            activate MP
            
                MP -> DM : Create(StaffProfile)
                activate DM
                     
                    DM --> MP : returns StaffProfile
                deactivate DM
            
                MP --> SV : returns StaffProfile
            deactivate MP
            
            
                
            SV -> REPO : AddAsync(StaffProfile)
            activate REPO
            
             REPO -> SQL : POST /staff (StaffProfile)
                            activate SQL
                            
            alt staff profile not in hospital's roster
            
                
                
                    SQL --> REPO : success: staff profile added in hospital's roster(returns ID)
                
                REPO --> SV : success: staff profile added in hospital's roster(returns ID)
            

            SV --> CN : success: staff profile added in hospital's roster(returns ID)
        FE <-- CN: success: staff profile added in hospital's roster (returns ID) 

else staff profile already in hospital's roster

               SQL --> REPO : error: staff profile already in hospital's roster
                deactivate SQL
                
        REPO --> SV : error:staff profile already in hospital's roster
            deactivate REPO
            SV --> CN : error:staff profile already in hospital's roster
        deactivate SV
        FE <-- CN: error:staff profile already in hospital's roster
    deactivate CN     
               
end
               
deactivate FE


@enduml