@startuml
autonumber

actor "Patient" as USER
participant "<<System>>\n SurgicalSync" as SYSTEM
participant "Firebase IAM API" as FIREBASE
participant "SMTP API" as EMAIL

activate USER

    USER -> SYSTEM: wants to register for healthcare application
    activate SYSTEM

        SYSTEM --> USER : provides IAM options
    deactivate SYSTEM
        
    USER -> SYSTEM : selects one and accepts terms
    
    activate SYSTEM
        alt User Already Exists
           USER <-- SYSTEM : informs error with suggestion
        else User Registered Successfully
            SYSTEM -> FIREBASE : creates user (with data)
            
            activate FIREBASE
                FIREBASE --> SYSTEM : user created
            deactivate FIREBASE
            
            SYSTEM -> EMAIL : sends email with confirmation link
            activate EMAIL
                EMAIL --> SYSTEM : email sent
            deactivate EMAIL
        
           USER <-- SYSTEM : confirms registration
        end
    deactivate SYSTEM
    
deactivate USER
@enduml