		{
			"name": "POST an operation type",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for status code 201\r",
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Parse the response JSON\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Log the response and status for debugging\r",
							"console.log(response);\r",
							"console.log(response.status);\r",
							"\r",
							"// Check if the response has required fields\r",
							"pm.test(\"Response contains the created operation type data\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\");\r",
							"    pm.expect(response).to.have.property(\"operationName\");\r",
							"    pm.expect(response).to.have.property(\"requiredStaff\").that.is.an(\"string\");\r",
							"    pm.expect(response).to.have.property(\"estimatedDuration\").that.is.an(\"string\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
