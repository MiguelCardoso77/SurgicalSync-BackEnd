		{
			"name": "GET an operation type by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Assuming the ID is passed as a query parameter or set in the environment\r",
							"const operationTypeId = pm.environment.get(\"operationTypeId\") || \"1\"; // Replace \"1\" with a default ID if needed\r",
							"\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Check if the response is an object (not an array)\r",
							"pm.test(\"Response is an object\", function () {\r",
							"    pm.expect(response).to.be.an(\"object\");\r",
							"});\r",
							"\r",
							"// Verify the operation type has the required fields\r",
							"pm.test(\"Operation type has all required fields\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\", operationTypeId);\r",
							"    pm.expect(response).to.have.property(\"operationName\").that.is.a(\"string\");\r",
							"    pm.expect(response).to.have.property(\"requiredStaff\").that.is.an(\"array\").and.is.not.empty;\r",
							"    pm.expect(response).to.have.property(\"estimatedDuration\").that.is.an(\"array\").and.is.not.empty;\r",
							"});\r",
							"\r",
							"// Check if requiredStaff contains specific roles (optional based on requirements)\r",
							"pm.test(\"requiredStaff contains necessary roles\", function () {\r",
							"    const requiredRoles = [\"Orthopaedist\", \"Anaesthetist\", \"Instrumenting Nurse\"];\r",
							"    requiredRoles.forEach(role => {\r",
							"        const hasRole = response.requiredStaff.some(staff => staff.includes(role));\r",
							"        pm.expect(hasRole).to.be.true;\r",
							"    });\r",
							"});\r",
							"\r",
							"// Verify estimatedDuration values are strings representing numbers\r",
							"pm.test(\"estimatedDuration contains valid duration values\", function () {\r",
							"    response.estimatedDuration.forEach(duration => {\r",
							"        pm.expect(duration).to.match(/^\\d+$/); // Checks if each duration is a numeric string\r",
							"    });\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
