		{
			"name": "PUT an operation type",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for status code 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Parse the response JSON\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Check if the response has required fields\r",
							"pm.test(\"Response contains updated operation type data\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\");\r",
							"    pm.expect(response).to.have.property(\"operationName\");\r",
							"    pm.expect(response).to.have.property(\"requiredStaff\").that.is.an(\"string\");\r",
							"    pm.expect(response).to.have.property(\"estimatedDuration\").that.is.an(\"string\");\r",
							"});\r",
							"\r",
							"// Define the expected data for validation\r",
							"const updatedData = {\r",
							"    id: \"11\",\r",
							"    operationName: \"New Name\",\r",
							"    requiredStaff: \"1 Experienced Surgeon\",\r",
							"    estimatedDuration: \"30, 60, 90\"\r",
							"};\r",
							"\r",
							"// Validate updated fields\r",
							"pm.test(\"ID remains the same\", function () {\r",
							"    pm.expect(response.id).to.eql(updatedData.id);\r",
							"});\r",
							"\r",
							"pm.test(\"Operation Name is updated correctly\", function () {\r",
							"    pm.expect(response.operationName).to.eql(updatedData.operationName);\r",
							"});\r",
							"\r",
							"pm.test(\"Required Staff is updated correctly\", function () {\r",
							"    pm.expect(response.requiredStaff).to.eql(updatedData.requiredStaff);\r",
							"});\r",
							"\r",
							"pm.test(\"Estimated Duration is updated correctly\", function () {\r",
							"    pm.expect(response.estimatedDuration).to.eql(updatedData.estimatedDuration);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
