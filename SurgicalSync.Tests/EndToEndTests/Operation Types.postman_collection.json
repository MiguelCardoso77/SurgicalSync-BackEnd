	"item": [
		{
			"name": "GET all operation types",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"pm.test(\"Response is an array\", function () {\r",
							"    pm.expect(Array.isArray(response)).to.be.true;\r",
							"});\r",
							"\r",
							"pm.test(\"Response array is not empty\", function () {\r",
							"    pm.expect(response.length).to.be.above(0);\r",
							"});\r",
							"\r",
							"response.forEach((operation, index) => {\r",
							"    pm.test(`Operation ${index + 1} has all required fields`, function () {\r",
							"        pm.expect(operation).to.have.property(\"id\");\r",
							"        pm.expect(operation).to.have.property(\"operationName\");\r",
							"        pm.expect(operation).to.have.property(\"requiredStaff\");\r",
							"        pm.expect(operation).to.have.property(\"estimatedDuration\");\r",
							"    });\r",
							"\r",
							"    // Verify requiredStaff is an array and has values\r",
							"    pm.test(`Operation ${index + 1} requiredStaff is a non-empty array`, function () {\r",
							"        pm.expect(Array.isArray(operation.requiredStaff)).to.be.true;\r",
							"        pm.expect(operation.requiredStaff.length).to.be.above(0);\r",
							"    });\r",
							"\r",
							"    // Verify estimatedDuration is an array and has values\r",
							"    pm.test(`Operation ${index + 1} estimatedDuration is a non-empty array`, function () {\r",
							"        pm.expect(Array.isArray(operation.estimatedDuration)).to.be.true;\r",
							"        pm.expect(operation.estimatedDuration.length).to.be.above(0);\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
