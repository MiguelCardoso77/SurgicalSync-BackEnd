							"// Test that properties have correct values\r",
							"pm.test(\"Properties have correct values\", () => {\r",
							"    pm.expect(response.deadlineDate).to.eql(\"2025-01-09\");\r",
							"    pm.expect(response.priority).to.eql(\"UrgentSurgery\");\r",
							"    pm.expect(response.operationTypeId).to.eql(\"1\");\r",
							"    pm.expect(response.medicalRecordNumber).to.eql(\"202411000008\");\r",
							"    pm.expect(response.staffId).to.eql(\"D202400004\");\r",
