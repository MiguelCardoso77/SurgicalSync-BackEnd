			"name": "GET all staff",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const response = pm.response.json();",
							"",
							"pm.test(\"Response is an array\", function () {",
							"    pm.expect(Array.isArray(response)).to.be.true;",
							"});",
							"",
							"pm.test(\"Response array is not empty\", function () {",
							"    pm.expect(response.length).to.be.above(0);",
							"});",
							"",
							"response.forEach((staff, index) => {",
							"    pm.test(`Staff ${index + 1} has all required fields`, function () {",
							"        pm.expect(staff).to.have.property(\"id\");",
							"        pm.expect(staff).to.have.property(\"staffName\");",
							"        pm.expect(staff).to.have.property(\"userEmail\");",
							"        pm.expect(staff).to.have.property(\"staffSpecialization\");",
							"    });",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
