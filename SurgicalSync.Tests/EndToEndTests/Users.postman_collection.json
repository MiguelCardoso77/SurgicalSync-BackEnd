	"item": [
		{
			"name": "GET all users",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"pm.test(\"Response is an array\", function () {\r",
							"    pm.expect(Array.isArray(response)).to.be.true;\r",
							"});\r",
							"\r",
							"pm.test(\"Response array is not empty\", function () {\r",
							"    pm.expect(response.length).to.be.above(0);\r",
							"});\r",
							"\r",
							"response.forEach((operation, index) => {\r",
							"    pm.test(`User ${index + 1} has all required fields`, function () {\r",
							"        pm.expect(operation).to.have.property(\"id\");\r",
							"        pm.expect(operation).to.have.property(\"userName\");\r",
							"        pm.expect(operation).to.have.property(\"userEmail\");\r",
							"        pm.expect(operation).to.have.property(\"userRole\");\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"id\": \"1\",\r\n    \"Username\": \"Migueli77\",\r\n    \"UserEmail\": \"1220808@isep.ipp.pt\",\r\n    \"UserRole\": \"Admin\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
