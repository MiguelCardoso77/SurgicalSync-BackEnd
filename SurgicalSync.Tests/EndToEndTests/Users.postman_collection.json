							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Check if the response is an object (not an array)\r",
							"pm.test(\"Response is an object\", function () {\r",
							"    pm.expect(response).to.be.an(\"object\");\r",
							"});\r",
							"\r",
							"// Verify the user has the required fields\r",
							"pm.test(\"User has all required fields\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\");\r",
							"    pm.expect(response).to.have.property(\"userName\").that.is.a(\"string\");\r",
							"    pm.expect(response).to.have.property(\"userEmail\").that.is.a(\"string\");\r",
							"    pm.expect(response).to.have.property(\"userRole\").that.is.a(\"string\");\r",
							"}); "
