		{
			"name": "DELETE specialization",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Specialization has all required fields\", function () {",
							"    const response = pm.response.json();",
							"    pm.expect(response).to.have.property(\"code\");",
							"    pm.expect(response).to.have.property(\"designation\").that.is.a(\"string\");",
							"    pm.expect(response).to.have.property(\"description\").that.is.a(\"string\");",
							"});",
							"",
							"// Tenta buscar a especialização deletada para confirmar que não existe mais",
							"pm.sendRequest({",
							"    url: pm.variables.get(\"baseUrl\") + \"/specializations/\" + pm.variables.get(\"code\"),",
							"    method: \"GET\"",
							"}, function (err, response) {",
							"    pm.test(\"Deleted specialization should not be found\", function () {",
							"        pm.expect(response.code).to.equal(404);",
							"    });",
							"});",
							"",
							"// Verifica se o corpo da resposta está no formato correto",
							"pm.test(\"Response should be in JSON format\", function () {",
							"    pm.response.to.be.json;",
							"    pm.response.to.have.jsonSchema({",
							"        type: \"object\",",
							"        required: [\"code\", \"designation\", \"description\"]",
							"    });",
							"});",
							"",
							"// Verifica o tempo de resposta",
							"pm.test(\"Response time is acceptable\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});"
						],
