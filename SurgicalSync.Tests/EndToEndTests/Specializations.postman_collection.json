						"exec": [
							"// Test for status code 201",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Parse the response JSON",
							"const response = pm.response.json();",
							"",
							"// Log the response and status for debugging",
							"console.log(response);",
							"console.log(response.status);",
							"",
							"// Check if the response has required fields",
							"pm.test(\"Response contains the created staff data\", function () {",
							"    pm.expect(response).to.have.property(\"code\").that.is.a(\"string\");",
							"    pm.expect(response).to.have.property(\"designation\").that.is.a(\"string\");",
							"    pm.expect(response).to.have.property(\"description\").that.is.a(\"string\");",
							"});"
