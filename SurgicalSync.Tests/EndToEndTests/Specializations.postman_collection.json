							"response.forEach((specialization, index) => {",
							"    pm.test(`Specialization ${index + 1} has all required fields`, function () {",
							"        pm.expect(specialization).to.have.property(\"code\");",
							"        pm.expect(specialization).to.have.property(\"description\");",
							"        pm.expect(specialization).to.have.property(\"description\");",
