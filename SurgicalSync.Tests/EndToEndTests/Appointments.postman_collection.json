		{
			"name": "GET all appointments",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"\r",
							"pm.test(\"Response is an array\", function () {\r",
							"    pm.expect(Array.isArray(response)).to.be.true;\r",
							"});\r",
							"\r",
							"pm.test(\"Response array is not empty\", function () {\r",
							"    pm.expect(response.length).to.be.above(0);\r",
							"});\r",
							"\r",
							"response.forEach((appointment, index) => {\r",
							"    pm.test(`Appointment ${index + 1} has all required fields`, function () {\r",
							"        pm.expect(appointment).to.have.property(\"id\");\r",
							"        pm.expect(appointment).to.have.property(\"status\");\r",
							"        pm.expect(appointment).to.have.property(\"date\");\r",
							"        pm.expect(appointment).to.have.property(\"time\");\r",
							"        pm.expect(appointment).to.have.property(\"roomNumber\");\r",
							"        pm.expect(appointment).to.have.property(\"operationRequestId\");\r",
							"        pm.expect(appointment).to.have.property(\"requiredStaff\");\r",
							"    });\r",
							"});\r",
							""
