		{
			"name": "PUT appointment",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for status code 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Parse the response JSON\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Check if the response has required fields\r",
							"pm.test(\"Response contains updated operation type data\", function () {\r",
							"    pm.expect(response).to.have.property(\"id\");\r",
							"    pm.expect(response).to.have.property(\"status\");\r",
							"    pm.expect(response).to.have.property(\"date\");\r",
							"    pm.expect(response).to.have.property(\"time\");\r",
							"    pm.expect(response).to.have.property(\"roomNumber\");\r",
							"    pm.expect(response).to.have.property(\"operationRequestId\");\r",
							"    pm.expect(response).to.have.property(\"requiredStaff\");\r",
							"});\r",
							"\r",
							"// Define the expected data for validation\r",
							"const updatedData = {\r",
							"    id: \"3\",\r",
							"    status: \"Scheduled\",\r",
							"    date: \"2024/12/25\",\r",
							"    time: \"240\",\r",
							"    roomNumber: \"4\",\r",
							"    operationRequestId: \"2\",\r",
							"    requiredStaff: \"Doctors\"\r",
							"};\r",
							"\r",
							"// Validate updated fields\r",
							"pm.test(\"ID remains the same\", function () {\r",
							"    pm.expect(response.id).to.eql(updatedData.id);\r",
							"});\r",
							"\r",
							"pm.test(\"Status is updated correctly\", function () {\r",
							"    pm.expect(response.status).to.eql(updatedData.status);\r",
							"});\r",
							"\r",
							"pm.test(\"RoomNumber is updated correctly\", function () {\r",
							"    pm.expect(response.roomNumber).to.eql(updatedData.roomNumber);\r",
							"});\r",
							"\r",
							"pm.test(\"RequiredStaff is updated correctly\", function () {\r",
							"    pm.expect(response.requiredStaff).to.eql(updatedData.requiredStaff);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
