@startuml
autonumber

actor "Admin" as USER
participant "<<System>>\n SurgicalSync" as SYSTEM

activate USER

    USER -> SYSTEM: wants to deactivate a staff 
    activate SYSTEM

        SYSTEM --> USER : request the staff to deactivate
    deactivate SYSTEM
        
    USER -> SYSTEM : selects a staff profile
    
    activate SYSTEM
        alt staff profile deactivated
            USER <-- SYSTEM : success: staff profile deactivated
        else staff profile already deactivated
            USER <-- SYSTEM : error: staff profile already deactivated
        end
    deactivate SYSTEM
    
deactivate USER
@enduml