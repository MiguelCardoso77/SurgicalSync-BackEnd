@startuml
autonumber

Title "UC10 - Patient Login Using External IAM Credentials"

actor "Patient" as P
participant "<<System>> \n SurgicalSync" as SYSTEM
participant "<<External System>> \n IAM Provider" as IAM

activate P 

P -> SYSTEM: requests login via external IAM provider

    activate SYSTEM
    
    SYSTEM --> P: asks for the user´s IAM credentials
    
    deactivate SYSTEM
    
P -> SYSTEM: submits credentials

    activate SYSTEM

    SYSTEM -> IAM: sends credentials for authentication (username/password)
    
    activate IAM

    alt correct credentials
        IAM --> SYSTEM: returns authentication token (success)
                
        SYSTEM -> SYSTEM: creates session for the patient
        
        SYSTEM --> P: shows operation success

    else wrong credentials
        IAM --> SYSTEM: returns error message (invalid credentials)
        deactivate IAM

        SYSTEM --> P: shows error message (invalid credentials)

    end

    deactivate SYSTEM

deactivate P

@enduml
