@startuml
autonumber

Title "UC27 - List operation requests"

participant "FrontEnd" as FE
participant "<<Controller>>\nOperationRequestController" as C
participant "<<Application>>\nOperationRequestService" as S
participant "<<Mappers>>\nOperationRequestMapper" as M
participant "<<DTO>>\nOperationRequestDTO" as DTO
participant "<<Repositories>>\nOperationRequestRepository" as R
database "SQL Database" as SQL

activate FE

FE -> C : GET /operationRequests

    activate C
    
    C -> S : GetAllAsync()
    
    activate S
    
    S -> R : GetAllAsync()
    
    activate R
    
    R -> SQL : SELECT * FROM OperationRequest
    
    activate SQL
    
    SQL --> R : List<OperationRequest>
    
    deactivate SQL
    
    R --> S : List<OperationRequest>
    
    deactivate R
    
    S -> M : ToDto(List<OperationRequest> list)
    
    activate M
    
    loop for all the list's members
    
    M -> DTO : Create(OperationRequestDTO(operationRequestId, priority, deadlineDate,\n operationTypeId, LicenseNumber, MedicalRecordNumber))
    
    activate DTO
    
    DTO --> M : OperationRequestDTO
    
    deactivate DTO
    
    end
    
    M --> S : List<OperationRequestDTO>
    
    deactivate M 
    
    S --> C : List<OperationRequestDTO>
    
    deactivate S
    
    C --> FE : List<OperationRequestDTO>
    
    deactivate C 
    
    alt The doctor applies one or more filters
    
    FE -> C : filters operation requests
    
    activate C
    
    C -> S : FilterOperationRequestsAsync(list)
    
    activate S
    
    S --> C : List<OperationRequestDTO>
    
    deactivate S 
    
    C --> FE : List<OperationRequestDTO>
    
    deactivate C 
    
    end 
    
deactivate FE 

@enduml