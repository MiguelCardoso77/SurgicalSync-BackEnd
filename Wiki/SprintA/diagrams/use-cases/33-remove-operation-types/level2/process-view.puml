@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE : wants to remove existing operation type
    activate FE
    
        FE -> BE : GET /operationTypes
        activate BE
        
            BE --> FE : returns operation types
        deactivate BE
    
        FE --> USER : lists existing operation types and \n asks user to select one
    deactivate FE

    USER -> FE : selects the operation type to remove
    activate FE
    
        alt Couldn't Remove Operation Type
           
        FE -> BE : DELETE /operationTypes/id
        activate BE
        
            BE --> FE : error: couldn't find operation type
        deactivate BE 
        FE --> USER : informs error with suggestion
        
        else Operation Type Removed Successfully
        
    FE --> USER : asks user for confirmation
    deactivate FE
    
        USER -> FE : confirms deletion
    activate FE
        
        FE -> BE : DELETE /operationTypes/id
        activate BE
        
            BE --> FE : success: returns success message
        deactivate BE
        FE --> USER : shows success message
        
        end
        
    deactivate FE
            
deactivate USER

@enduml