@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE : wants to display details for selected operation type
    activate FE
    
        FE -> BE : GET /operationTypes/id
        activate BE
        
            BE --> FE : returns operation type
        deactivate BE
    
        alt Couldn't Find Operation Types
        FE --> USER : informs error with suggestion
        else Operation Type Listed Successfully
        FE --> USER : shows operation type details
    deactivate FE
        end
            
deactivate USER

@enduml