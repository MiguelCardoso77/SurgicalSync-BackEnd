@startuml
'https://plantuml.com/class-diagram

title "UC7 - Delete my account and all associated data"

package "Domain"{

package "Users"{

class User {
    - UserEmail
    - UserPassword
    - Username
    - UserRole
    - IsActive
    + User(UserEmail userEmail, Username username, UserRole userRole, Password password)
    + ChangeUsername(Username username)
    + ChangeUserRole(UserRole userRole)
    + ChangePassword(Password password)
    + ActivateUser()
    + DeactivateUser()  
}

class UserId {
    + UserId(string value)
}

class Username {
    + Username(string username)
}

class UserEmail {
    + UserEmail(string email)
}

enum UserRole {
    - Admin
    - Doctor
    - Nurse
    - Technician
    - Patient
}
}

package "Patients"{
class Patient {
    - Patient Name
    - Birth Date
    - Gender
    - Medical Record Number
    - Phone Number
    - Medical Conditions
    - Emergency Contact
    - Appointment History
    - Email
    + Patient(PatientName patientName, BirthDate birthDate, Gender gender, MedicalRecordNumber medicalRecordNumber, 
        PhoneNumber phoneNumber, List<MedicalConditions> medicalConditions, 
        EmergencyContact emergencyContact, List<AppointmentHistory> appointmentHistory, UserEmail email)
}

class MedicalRecordNumber {
    + MedicalRecordNumber(string value)
}

class PatientName {
    + PatientName(string patientName)
}

class BirthDate {
    + BirthDate(string birthDate)
}

class PhoneNumber {
    + PhoneNumber(string phoneNumber)
}

class MedicalConditions {
    + MedicalConditions(string medicalConditions)
}

class EmergencyContact {
    + EmergencyContact(string emergencyContact)
}

class Gender {
    + Gender(string gender)
}

class AppointmentHistory {
    + AppointmentHistory(string appointmentHistory)
}

}
}

package "DTO"{

class UserMapper {
    + ToDomain(UserDto dto, UserId userId)
    + ToDto(User user)
}


class PatientDTO {
    - Patient Name
    - Birth Date
    - Gender
    - Medical Record Number
    - Phone Number
    - Medical Conditions
    - Emergency Contact
    - Appointment History
}

class UserDTO {
    - UserEmail
    - UserName
    - IsActive
}

class PatientMapper {
    + ToDomain(PatientDto dto, MedicalRecordNumber)
    + ToDto(Patient patient)
}


}

package "Application"{

    class DeletePatientMicroService{
        + DeletePatientDataByGDPRAndAccount(MedicalRecordNumber medicalRecordNumber)
    }
    
    class UserService {
        + GetAllAsync()
        + GetByIdAsync(UserId id)
        + AddAsync(UserDto dto)
        + UpdateAsync(UserDto dto)
        + InactivateAsync(UserId id)
        + DeleteAsync(UserId id)
    }
    
    class PasswordService {
        + GeneratePassword()
    }
    
    class EmailService {
        + SendEmail()
    }
    class FirebaseService {
        + CreateUserRecordAsync(email, password, role)
    }
    
    class PatientService {
        + GetAllAsync()
        + GetByIdAsync(PatientId id)
        + AddAsync(PatientDto dto)
        + UpdateAsync(PatientDto dto)
        + InactivateAsync(PatientId id)
        + DeleteAsync(PatientId id)
    }
}

package "Repositories"{
interface IUserRepository {
}

interface UserRepository {
}

class BaseRepository {
    ====
    Classe do projeto base
    ====
}

interface IPatientRepository {
}

interface PatientRepository {
}

}

package "Controllers"{

class PatientsController {
    + GetAll()
    + GetById(String id)
    + Create(PatientDto dto)
    + Update(String id, PatientDto dto)
    + Delete(String id)
}

class UsersController {
    + GetAll()
    + GetGetById(String id)
    + Create(UserDto dto)
    + Update(String id, UserDto dto)
    + SoftDelete(String id)
    + HardDelete(String id)
}
}

PatientsController -> PatientService
PatientService --> PatientMapper : uses
PatientService -> PatientDTO : creates

PatientMapper <-- PatientDTO : enters
PatientMapper --> Patient : creates

Patient --> MedicalRecordNumber : has a
Patient --> PatientName : has a
Patient --> PhoneNumber : has a
Patient --> EmergencyContact : has a
Patient --> BirthDate : has a
Patient --> Gender : has a
Patient --> UserEmail : has a
Patient --> MedicalConditions : has multiple
Patient --> AppointmentHistory : has multiple

PatientService --> PatientRepository
PatientRepository --|> BaseRepository
PatientRepository -|> IPatientRepository

UsersController -> UserService
UserService ---> UserMapper : uses
UserService --> UserDTO : creates

UserService --> PasswordService : uses
UserService -> EmailService : uses
UserService --> FirebaseService : uses

UserMapper <-- UserDTO : receives
UserMapper --> User : creates

User --> UserId : has a
User --> Username : has a
User --> UserEmail : has a
User --> UserRole : has a

UserService --> UserRepository
UserRepository --|> BaseRepository
UserRepository -|> IUserRepository

UserService --> PasswordService : uses
UserService -> EmailService : uses

DeletePatientMicroService --> UserService
DeletePatientMicroService --> PatientService
DeletePatientMicroService --> EmailService

PatientsController --> DeletePatientMicroService
@enduml