@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE: wants to edit a patient profile
    activate FE
        
        FE -> BE : GET /Patients
        activate BE
            
            BE --> FE : returns patients
        deactivate BE
        
        FE --> USER :  lists all patient profiles and asks to select one
    deactivate FE
        
    USER -> FE : selects patient profile
    activate FE
    
        FE --> USER : requests new profile details 
    deactivate FE
    
    USER -> FE : gives information to replace
    activate FE
        
        FE -> BE : PUT /Patients/id (with given data)
        activate BE
            
            BE --> FE : success: edited patient profile
        deactivate BE
    
    USER <-- FE : success: edited patient profile
    deactivate FE
deactivate USER
@enduml
