@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE: wants to delete a patient profile
    activate FE
        
        FE -> BE : GET /Patients
        activate BE
            
            BE --> FE : returns patients
        deactivate BE
        
        FE --> USER :  lists all patient profiles and asks to select one
    deactivate FE
        
    USER -> FE : selects patient profile
    activate FE
    
        FE --> USER : requests confirmation
        deactivate FE
        
    USER -> FE : confirms deletion
    activate FE
        
        FE -> BE : DELETE /Patients/id
        activate BE
        
alt Couldn't Find Patient Profile           
            BE --> FE : error : couldn't find patient profile
            
        FE --> USER : informs error with suggestion
        
else Patient Deleted Successfully
        
            BE --> FE : success: patient profile deleted
        deactivate BE
                
        FE --> USER : success: patient profile deleted
        deactivate FE
end
deactivate USER
@enduml
