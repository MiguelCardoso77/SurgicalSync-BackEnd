@startuml
autonumber

actor "Admin" as USER

participant "FrontEnd" as FE
participant "BackEnd" as BE

activate USER

    USER -> FE : wants to list staff 
    activate FE
    
    FE -> BE : GET /staff
    activate BE
    
    BE --> FE : return list of staff  
    deactivate BE
    
    FE --> USER : lists staff  
    deactivate FE

    
 
deactivate USER

@enduml