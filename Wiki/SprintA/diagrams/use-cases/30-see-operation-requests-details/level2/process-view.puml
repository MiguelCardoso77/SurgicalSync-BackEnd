@startuml
autonumber

Title "UC30 - See an operation requisition details"

actor "Doctor" as D
participant "FrontEnd" as FE
participant "BackEnd" as BE

activate D

D -> FE: requests to see the details \nof an operation requisition 

    activate FE
    
    FE -> BE : GET /operationRequisitions
    
    activate BE
    
    BE --> FE : list of operationRequisitions
    
    deactivate BE
    
    FE --> D : shows the list of all the operation \n requisitions and asks for the id
    
    deactivate FE
    
    D -> FE : Inserts the id
    
    alt the requested operation exists
    
    activate FE
    
    FE -> BE : GET /operationRequisitions/{id}
    
    activate BE
    
    BE --> FE : operationRequisition details (eg., operationRequisitionId, \n DeadlineDate, Priority, OperationType and PatientNumber)
    
    deactivate BE
    
    FE --> D: shows the operation requisition's details \n (eg., operationRequisitionId, DeadlineDate, Priority \n OperationType and PatientNumber) 
        
    else
    
    FE --> D : shows error message
    
    deactivate FE
    
    end   
    
deactivate D

@enduml