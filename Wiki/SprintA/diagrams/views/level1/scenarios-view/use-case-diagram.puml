@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
'skinparam shadowing false

skinparam rectangle{
    BorderColor black
}

left to right direction

skinparam actor {
    BackgroundColor LightBlue
    BorderColor Blue
    FontColor Black
}

actor "Admin" as A #LightBlue
actor "BackofficeUser" as BU #LightGreen
actor "Patient" as P #Yellow
actor "Doctor" as D #Red
actor "Non-authenticated Backoffice User" as NA #Violet

title "Use Case Diagram"

rectangle "System" as backoffice {

    usecase "uc01 - register new backoffice user via an out-of-band process"
    usecase "uc13 - create new patient profile"
    usecase "uc14 - register patient's personal details and medical history"
