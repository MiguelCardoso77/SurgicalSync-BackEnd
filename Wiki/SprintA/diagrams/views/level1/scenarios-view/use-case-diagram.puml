    usecase "uc06 - change my personal details"
    usecase "uc07 - change my preferences"
    usecase "uc08 - delete my account and all associated data"
    usecase "uc11 - log in to the system using the IAM credentials"
    usecase "uc12 - access my features"
    
    P --> "uc03 - register for the health care application"
    P --> "uc04 - create a user profile"
    P --> "uc05 - book appointments online"
    P --> "uc06 - change my personal details"
