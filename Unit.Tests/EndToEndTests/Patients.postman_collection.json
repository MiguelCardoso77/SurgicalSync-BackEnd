		{
			"name": "GET all patients",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"const response = pm.response.json();",
							"",
							"pm.test(\"Response is an array\", function () {",
							"    pm.expect(Array.isArray(response)).to.be.true;",
							"});",
							"",
							"pm.test(\"Response array is not empty\", function () {",
							"    pm.expect(response.length).to.be.above(0);",
							"});",
							"",
							"response.forEach((patient, index) => {",
							"    pm.test(`Patient ${index + 1} has all required fields`, function () {",
							"        pm.expect(patient).to.have.property(\"patientName\");",
							"        pm.expect(patient).to.have.property(\"birthDate\");",
							"        pm.expect(patient).to.have.property(\"gender\");",
							"        pm.expect(patient).to.have.property(\"medicalRecordNumber\");",
							"        pm.expect(patient).to.have.property(\"phoneNumber\");",
							"        pm.expect(patient).to.have.property(\"medicalConditions\");",
							"        pm.expect(patient).to.have.property(\"emergencyContact\");",
							"        pm.expect(patient).to.have.property(\"appointmentHistory\");",
							"        pm.expect(patient).to.have.property(\"email\");",
							"",
							"",
							"    });",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
