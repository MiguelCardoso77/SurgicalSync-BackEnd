		{
			"name": "DELETE patient",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Test for status code 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Parse the response JSON\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Define expected values directly in the test\r",
							"const expectedPatient = {\r",
							"    patientName: \"Diana\",\r",
							"    birthDate: \"30 de Junho de 2004\",\r",
							"    gender: \"Feminino\",\r",
							"    medicalRecordNumber: \"202409000001\",\r",
							"    phoneNumber: \"938413938\",\r",
							"    medicalConditions: [],\r",
							"    emergencyContact: \"933264402\",\r",
							"    appointmentHistory: [],\r",
							"    email: \"1221195@isep.ipp.pt\"\r",
							"};\r",
							"\r",
							"// Test to check if response matches expected patient values\r",
							"pm.test(\"Response matches expected patient values\", function () {\r",
							"    pm.expect(response).to.deep.equal(expectedPatient);\r",
							"});\r",
							"\r",
							"// Additional field checks\r",
							"pm.test(\"Response has all required fields\", function () {\r",
							"    pm.expect(response).to.have.all.keys([\r",
							"        \"patientName\",\r",
							"        \"birthDate\",\r",
							"        \"gender\",\r",
							"        \"medicalRecordNumber\",\r",
							"        \"phoneNumber\",\r",
							"        \"medicalConditions\",\r",
							"        \"emergencyContact\",\r",
							"        \"appointmentHistory\",\r",
							"        \"email\"\r",
							"    ]);\r",
							"});\r",
							"\r",
							"\r",
							"// Test if the medicalConditions is an array\r",
							"pm.test(\"Medical conditions is an array\", function () {\r",
							"    pm.expect(response.medicalConditions).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"// Test if appointmentHistory is an array\r",
							"pm.test(\"Appointment history is an array\", function () {\r",
							"    pm.expect(response.appointmentHistory).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"// Test for non-empty emergency contact\r",
							"pm.test(\"Emergency contact is not empty\", function () {\r",
							"    pm.expect(response.emergencyContact).to.not.be.empty;\r",
							"});\r",
							"\r",
							"// Test for phone number format (basic validation)\r",
							"pm.test(\"Phone number is in correct format\", function () {\r",
							"    const phoneRegex = /^\\d{9}$/; // Regex para 9 dígitos seguidos\r",
							"    pm.expect(response.phoneNumber).to.match(phoneRegex);\r",
							"});\r",
							"\r",
							"// Test for email format\r",
							"pm.test(\"Email is in correct format\", function () {\r",
							"    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/; // Regex para validar email\r",
							"    pm.expect(response.email).to.match(emailRegex);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
