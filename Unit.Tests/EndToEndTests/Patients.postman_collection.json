						"exec": [
							"// Test for status code 200 (or 201 if created successfully)\r",
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Parse the response JSON\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Define expected values diretamente no teste\r",
							"const expectedPatient = {\r",
							"    patientName: \"Tomás\",\r",
							"    birthDate: \"30 de Junho de 2004\",\r",
							"    gender: \"Feminino\",\r",
							"    medicalRecordNumber: \"202409000015\",\r",
							"    phoneNumber: \"938000111\",\r",
							"    medicalConditions: [],\r",
							"    emergencyContact: \"933264408\",\r",
							"    appointmentHistory: [],\r",
							"    email: \"1221190@isep.ipp.pt\",\r",
							"};\r",
							"\r",
							"// Test to check if response has all required fields and matches expected values\r",
							"pm.test(\"Response matches expected patient values\", function () {\r",
							"    pm.expect(response).to.deep.equal(expectedPatient);\r",
							"});\r",
							"\r",
							"// Additional field checks\r",
							"pm.test(\"Response has all required fields\", function () {\r",
							"    pm.expect(response).to.have.all.keys([\r",
							"        \"patientName\",\r",
							"        \"birthDate\",\r",
							"        \"gender\",\r",
							"        \"medicalRecordNumber\",\r",
							"        \"phoneNumber\",\r",
							"        \"medicalConditions\",\r",
							"        \"emergencyContact\",\r",
